# Copy this file to .env and fill in your own key — never commit the real .env.
# python-dotenv (already in requirements.txt) will auto-load it if you add
# `from dotenv import load_dotenv; load_dotenv()` before running, or just
# `export $(cat .env | xargs)` in your shell.

# Using OpenRouter (https://openrouter.ai/keys) instead of OpenAI directly:
OPENAI_API_KEY=your_openrouter_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Using OpenAI directly instead, just set:
# OPENAI_API_KEY=your_openai_api_key_here
# (and omit OPENAI_BASE_URL)
